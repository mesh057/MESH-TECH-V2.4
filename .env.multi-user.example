# Additive multi-user layer for the supplied MESH TECH MD rebrand.
# Merge these values into your private environment; never commit session data.
MULTI_USER_AUTH_DIR=auth_sessions
MAX_BOT_INSTANCES=unlimited
MULTI_USER_PORT=3000

# Single-session-compatible defaults. The multi-user manager overrides these
# per child session so every WhatsApp account gets isolated durable paths.
AUTH_DIR=auth_info
DATA_FILE=data/database.json

# Railway/VPS: point MULTI_USER_AUTH_DIR at a mounted persistent volume.
# Example: /data/meshtech/auth_sessions

# Server-to-server MESH AI bridge. Configure the same high-entropy value on the
# Railway bot host and companion backend; never place it in the APK.
MESH_COMPANION_CONTROL_TOKEN=replace-with-at-least-32-random-characters
