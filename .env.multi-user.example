# Additive multi-user layer for the supplied MESH TECH MD rebrand.
# Merge these values into your private environment; never commit auth_sessions.
MULTI_USER_AUTH_DIR=auth_sessions
MULTI_USER_PORT=3000

# Server-to-server MESH AI bridge. Configure the same high-entropy value on the
# Railway bot host and companion backend; never place it in the APK.
MESH_COMPANION_CONTROL_TOKEN=replace-with-at-least-32-random-characters
