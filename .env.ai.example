# MESH AI configuration
# Copy the values you need into your host's private environment settings.
# Do not commit API keys, session folders, or a real .env file to GitHub.

# Turns the MESH AI service on or off at bot startup.
MESH_AI_ENABLED=true

# Choose one model mode: managed or ollama
MESH_AI_PROVIDER=managed
MESH_AI_NAME=MESH AI
MESH_AI_TEMPERATURE=0.7
MESH_AI_MAX_TOKENS=500
MESH_AI_TIMEOUT_MS=45000

# Optional owner-written behavior notes, such as the preferred tone or language.
# MESH_AI_SYSTEM_PROMPT=Reply in English and Swahili. Keep answers brief and respectful.

# Managed AI account mode
# Use an OpenAI-compatible endpoint and model available in your own provider account.
# MESH_AI_API_KEY=
MESH_AI_MANAGED_BASE_URL=https://api.openai.com/v1
MESH_AI_MANAGED_MODEL=gpt-4.1-mini

# Self-hosted Ollama mode
# The bot host must be able to reach this address. localhost only works when
# Ollama runs on the same server as the bot.
MESH_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# MESH_AI_OLLAMA_MODEL=llama3.2:3b

# Optional live public-web search
# Set `auto` to search for time-sensitive questions such as current news,
# weather, prices, results, or requests that explicitly ask for sources.
# Set `always` to search for every question, or `off` to disable web search.
MESH_AI_WEB_SEARCH_MODE=auto
# MESH_AI_TAVILY_API_KEY=
MESH_AI_TAVILY_BASE_URL=https://api.tavily.com
MESH_AI_TAVILY_SEARCH_DEPTH=fast
MESH_AI_TAVILY_MAX_RESULTS=3

# Android MESH AI Companion
# Create a long, private random token in your host dashboard. The APK stores it
# in Android secure storage and sends it only to this hosted bot over HTTPS.
# MESH_COMPANION_CONTROL_TOKEN=
# Independent host-outage relay. Use the same memorable random value in the
# MESH AI Android companion project and in your external uptime monitor webhook.
# MESH_UPTIME_RELAY_SECRET=

# Durable encrypted MESH AI history relay. Add the companion API URL after it is published.
# MESH_HISTORY_RELAY_URL=https://YOUR-MESH-AI-RELAY-HOST
# MESH_HISTORY_RELAY_TOKEN=

# This is only for directly starting index.js as a single bot. Railway's
# default npm start command launches the multi-user pairing page instead, so
# each user supplies their own number in the browser and no shared phone-number
# variable is needed there.
# MESH_PAIRING_PHONE_NUMBER=254700000000

# Multi-user Railway session storage. Mount a Railway Volume at this same path
# so each user's linked WhatsApp session survives restarts and redeployments.
MULTI_USER_AUTH_DIR=/app/auth_sessions

# Branded message sent only to the user’s own WhatsApp account after that user
# successfully connects a multi-user session. The bundled MESH logo is used.
# Set this to false to disable the message without changing command behavior.
MESH_CONNECTED_MESSAGE_ENABLED=true
# OFFICIAL_GROUP_INVITE=https://chat.whatsapp.com/YOUR_GROUP_INVITE
# OFFICIAL_CHANNEL_URL=https://whatsapp.com/channel/YOUR_CHANNEL_ID

# Automatic direct-message replies stay OFF by default. From the owner account,
# send `.chatbot on` after deployment to let MESH AI answer normal messages in
# all direct messages. Send `.chatbot off` to stop automatic replies globally.
