# MESH AI configuration
# Copy the values you need into your host's private environment settings.
# Do not commit API keys, session folders, or a real .env file to GitHub.

# Turn MESH AI on or off at bot startup.
MESH_AI_ENABLED=true

# Choose one mode: managed or ollama
MESH_AI_PROVIDER=managed
MESH_AI_NAME=MESH AI
MESH_AI_TEMPERATURE=0.7
MESH_AI_MAX_TOKENS=500
MESH_AI_TIMEOUT_MS=45000

# Optional owner-written behavior notes, such as the preferred tone or language.
# MESH_AI_SYSTEM_PROMPT=Reply in English and Swahili. Keep answers brief and respectful.

# Managed AI account mode
# Use an OpenAI-compatible endpoint and model available in your own provider account.
# MESH_AI_API_KEY=
MESH_AI_MANAGED_BASE_URL=https://api.openai.com/v1
MESH_AI_MANAGED_MODEL=gpt-4.1-mini

# Self-hosted Ollama mode
# The bot host must be able to reach this address. localhost only works when
# Ollama runs on the same server as the bot.
MESH_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# MESH_AI_OLLAMA_MODEL=llama3.2:3b
